# Production Environment Configuration
# Copy this file to .env and update with your production values

# ============================================================================
# Database Configuration (External PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://user:secure_password@db.production.com:5432/pickloan

# ============================================================================
# External Services
# ============================================================================

# Supabase File Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-production-service-key

# Nova AI API for Document Extraction
NOVA_API_KEY=your-production-nova-api-key

# ============================================================================
# Environment Settings
# ============================================================================
NODE_ENV=production

# ============================================================================
# Application Configuration
# ============================================================================
API_PORT=8000

# Log level (debug, info, warning, error)
LOG_LEVEL=info

# ============================================================================
# Security (Optional)
# ============================================================================

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://app.production.com,https://web.production.com

# API Key for internal requests (if needed)
INTERNAL_API_KEY=your-internal-api-key

# ============================================================================
# SSL/TLS Configuration (for nginx)
# ============================================================================
# Paths to SSL certificates (mount in docker-compose.nginx.yml)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# ============================================================================
# Monitoring & Observability (Optional)
# ============================================================================

# Sentry for error tracking
# SENTRY_DSN=https://key@sentry.io/project-id

# DataDog for monitoring
# DATADOG_API_KEY=your-datadog-key

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# File Upload Settings
# ============================================================================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ============================================================================
# Job Queue (Optional - for async processing)
# ============================================================================
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# Notification Settings (Optional)
# ============================================================================
# SMTP_SERVER=smtp.production.com
# SMTP_PORT=587
# SMTP_USERNAME=alerts@production.com
# SMTP_PASSWORD=smtp-password
# NOTIFICATION_EMAIL=admin@production.com

# ============================================================================
# Notes
# ============================================================================
# 1. Never commit .env file to version control
# 2. Use strong, unique passwords for production
# 3. Store sensitive keys in a secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 4. Rotate API keys regularly
# 5. Enable audit logging for sensitive operations
# 6. Use SSL/TLS for all communications



EXPO_PUBLIC_OAUTH_PORTAL_URL=https://your-oauth-portal
EXPO_PUBLIC_OAUTH_SERVER_URL=https://your-oauth-server
EXPO_PUBLIC_APP_ID=your-app-id
EXPO_PUBLIC_OWNER_OPEN_ID=your-owner-id
EXPO_PUBLIC_OWNER_NAME="Your Organization"
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000